{
  "id": "customer",
  "name": "Customer Spec (고객 요구 사양)",
  "description": "고객 요구사항 문서용. '1.' 형식 번호 제목, 요구사항 ID(REQ-xxx-nnn) 보존 검증, 'Confidential' 머리글 제거, 괘선 없는 일정표 보조 추출.",
  "extends": "general",
  "overrides": {
    "parsing": {
      "header_footer": {"extra_patterns": ["(?i)^.*\\bconfidential\\b.*$"]},
      "metadata": {"doc_number_pattern": "\\b((?:CRS|SPEC|REQ|CS)-[A-Z0-9][A-Z0-9\\-]+)", "tags": ["customer"]}
    },
    "validation": {"extra_token_patterns": ["\\bREQ-[A-Z]{2,5}-\\d{2,4}\\b"]}
  }
}
