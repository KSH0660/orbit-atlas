[
  {
    "id": "corp-vlm",
    "name": "사내 Vision LLM (OpenAI 호환)",
    "type": "openai",
    "base_url": "https://llm-gateway.corp.local/v1",
    "model": "Qwen2.5-VL-72B-Instruct",
    "api_key_env": "INTERNAL_LLM_KEY",
    "timeout_s": 180,
    "max_retries": 2,
    "ca_bundle": "/etc/pki/tls/certs/corp-root-ca.pem",
    "extra_body": {"top_p": 1}
  },
  {
    "id": "corp-ocr",
    "name": "사내 OCR API (Custom HTTP)",
    "type": "custom_http",
    "base_url": "https://ocr.corp.local",
    "endpoint_path": "/api/v2/recognize",
    "api_key_env": "INTERNAL_OCR_KEY",
    "auth_header": "X-API-Key",
    "auth_scheme": "",
    "request_template": "{\"image\": \"{{image_base64}}\", \"lang\": \"en\", \"instruction\": \"{{prompt}}\"}",
    "response_path": "result.text"
  }
]
