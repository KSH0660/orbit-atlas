# Optional reverse proxy (TLS termination, larger uploads, long-running requests)
server {
    listen 443 ssl;
    server_name spec2kb.corp.local;
    ssl_certificate     /etc/pki/tls/certs/spec2kb.crt;
    ssl_certificate_key /etc/pki/tls/private/spec2kb.key;

    client_max_body_size 300m;          # = S2K_MAX_UPLOAD_MB
    proxy_read_timeout   600s;          # ZIP export of large knowledge bases

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
