[Unit]
Description=Spec-to-Knowledge (PDF specification -> Markdown knowledge base)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spec2kb
Group=spec2kb
EnvironmentFile=/etc/spec2kb/spec2kb.env
WorkingDirectory=/var/lib/spec2kb
ExecStart=/opt/spec2kb/venv/bin/spec2kb serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/spec2kb
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
