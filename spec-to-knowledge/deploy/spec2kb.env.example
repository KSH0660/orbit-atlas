# Spec-to-Knowledge environment (systemd EnvironmentFile: KEY=VALUE, no quotes, no export)

# --- server --------------------------------------------------------------------
S2K_HOST=0.0.0.0
S2K_PORT=8765
S2K_DATA_DIR=/var/lib/spec2kb
# number of documents processed in parallel (each uses ~1 CPU core while parsing)
S2K_WORKERS=2
S2K_MAX_UPLOAD_MB=300
S2K_LOG_LEVEL=INFO
# HTTP Basic auth for UI + API ("user:password"); empty = no auth (use a reverse proxy / SSO instead)
S2K_BASIC_AUTH=
# preview image resolution in the review screen
S2K_PREVIEW_DPI=110

# --- model providers -----------------------------------------------------------------
# provider used when a profile does not name one ("mock" = offline deterministic test provider)
S2K_DEFAULT_PROVIDER=mock
# CA bundle for HTTPS calls to in-house model gateways (internal PKI)
S2K_CA_BUNDLE=
# set to 0 to forbid storing API keys in providers.json (keys must then come from env vars)
S2K_ALLOW_API_KEY_STORAGE=1
# optional JSON list of providers created on first start (see docs/PROVIDERS.md)
S2K_PROVIDERS_SEED=

# API keys referenced by providers through "api_key_env" (examples)
#INTERNAL_LLM_KEY=change-me
#INTERNAL_OCR_KEY=change-me

# corporate HTTP proxy for model endpoints, if any (httpx honours these)
#HTTPS_PROXY=
#NO_PROXY=localhost,127.0.0.1,.corp.local
