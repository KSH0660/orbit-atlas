# All variables are optional. Orbit Atlas runs with zero configuration.

# Base URL for CelesTrak (override to point at a mirror or a proxy).
CELESTRAK_BASE_URL=https://celestrak.org

# How long (seconds) the live catalog is cached before revalidation.
# CelesTrak asks clients not to download the same data more than once every 2 hours.
# Note: the route-level ISR interval is fixed at build time (7200 s); this value
# controls the in-memory warm-instance cache.
CATALOG_CACHE_SECONDS=7200

# Set to "1" to skip the live fetch and always serve the bundled snapshot
# (useful for offline development or if CelesTrak blocks your egress IP).
ORBIT_ATLAS_OFFLINE=0

# Contact string sent in the User-Agent to upstream data providers.
ORBIT_ATLAS_CONTACT=https://github.com/ksh0660/orbit-atlas

# Public site URL used for Open Graph metadata (Vercel sets VERCEL_URL automatically).
NEXT_PUBLIC_SITE_URL=
